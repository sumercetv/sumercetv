# En Vercel se usa automáticamente VERCEL_PROJECT_PRODUCTION_URL.
# Fuera de Vercel, configura aquí el dominio público que ya esté activo.
NEXT_PUBLIC_SITE_URL=https://sumercetv.vercel.app
# Opcional: fuerza un canonical HTTPS específico (solo servidor).
# Cambiar a https://sumercetv.com únicamente cuando dominio y HTTPS funcionen.
SITE_URL=
# Opcionales: solo el valor del token de verificación, sin la etiqueta HTML.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: formularios, eventos publicitarios y limitación persistente.
SUPABASE_SECRET_KEY=
# Generar una cadena aleatoria de al menos 32 caracteres. Nunca NEXT_PUBLIC_.
RATE_LIMIT_SALT=
# Cabecera IP SOLO si el proxy de despliegue la sobrescribe y es confiable.
# Ejemplo Vercel: x-vercel-forwarded-for; vacío agrupa por cliente anónimo.
TRUSTED_IP_HEADER=
