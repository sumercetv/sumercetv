# En Vercel se usa automáticamente VERCEL_PROJECT_PRODUCTION_URL.
# Fuera de Vercel, configura aquí el dominio público que ya esté activo.
NEXT_PUBLIC_SITE_URL=https://sumercetv.vercel.app
# Opcional: fuerza un canonical HTTPS específico (solo servidor).
# Cambiar a https://sumercetv.com únicamente cuando dominio y HTTPS funcionen.
SITE_URL=
# Opcionales: solo el valor del token de verificación, sin la etiqueta HTML.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: formularios, eventos publicitarios y limitación persistente.
SUPABASE_SECRET_KEY=
# Generar una cadena aleatoria de al menos 32 caracteres. Nunca NEXT_PUBLIC_.
RATE_LIMIT_SALT=
# Cabecera IP SOLO si el proxy de despliegue la sobrescribe y es confiable.
# Ejemplo Vercel: x-vercel-forwarded-for; vacío agrupa por cliente anónimo.
TRUSTED_IP_HEADER=

# ── Analítica (opcional: si la variable no existe, no se carga nada) ──
# Google Analytics 4: ID de medición, formato G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
# Meta Pixel: ID numérico del píxel.
NEXT_PUBLIC_META_PIXEL_ID=
# Vercel Web Analytics (incluido en Hobby): "1" tras activarlo en el panel del proyecto.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# ── Notificación de lead nuevo (opcional, solo servidor) ──
# El lead se guarda SIEMPRE primero en Supabase; si una notificación falla solo se registra.
# Webhook HTTPS (GoHighLevel, n8n…): recibe POST {"event":"lead.created","lead":{…}}.
LEADS_WEBHOOK_URL=
# Correo interno vía Resend (plan gratuito). Varios destinatarios separados por coma.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
# Remitente con dominio verificado en Resend. Sin él se usa onboarding@resend.dev,
# que solo entrega al correo dueño de la cuenta de Resend.
LEADS_FROM_EMAIL=
